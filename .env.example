# Opveil — copy to .env.local (never commit secrets)
# Only NEXT_PUBLIC_* values are exposed to the browser. Everything else stays server-side.

# --- Networks (override public defaults with a dedicated provider in production) ---
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
BSC_EXPLORER_URL=https://bscscan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RPC_TIMEOUT_MS=15000

# --- Explorer APIs (optional; improves source-verification status) ---
BSCSCAN_API_KEY=
ROBINHOOD_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api

# --- Persistence (optional for local runs; file-backed history is the default) ---
DATABASE_URL=postgresql://opveil:opveil@localhost:5432/opveil
REDIS_URL=

# --- AI explanation (optional; OpenAI-compatible provider) ---
# Without LLM_API_KEY the app shows deterministic summaries + explicit "AI unavailable".
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=25000

# --- Decompiler adapter (optional external binary; sandboxed, no shell) ---
DECOMPILER_CMD=

# --- Rate limiting ---
RATE_LIMIT_PER_MIN=30
